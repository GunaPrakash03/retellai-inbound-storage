PORT=8000
RETELL_API_KEY=key_xxxxxxxxxxxxxxxxxxxxxxxx
DB_PATH=./data/cases.db
FRONTEND_ORIGIN=http://localhost:5173
# Optional extra auth for POST /case-lookup: a static shared secret sent as
# an X-API-Key header, configured as a custom header on the Retell custom
# function. A valid X-Retell-Signature is accepted as an alternative. If
# neither this nor RETELL_API_KEY is set, the endpoint is open (local dev).
CASE_LOOKUP_API_KEY=
# Set to 1 to enable the unauthenticated /debug/* routes. Leave unset in
# production: /debug/last-webhook echoes a real call's full transcript.
DEBUG_ENDPOINTS=
# Gemini API key for the post-call taxonomy classifier (app/classify.py). When
# unset, completed employment calls simply don't get a case type/subtype — the
# case still lands correctly by practice area. GEMINI_MODEL is optional.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
